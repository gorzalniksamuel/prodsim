# ProdSim compose stack configuration.
#
# `make up` copies this file to deploy/compose/.env (if missing) and replaces every
# value marked "change-me" with a random one. To configure by hand instead:
#   cp deploy/compose/.env.example deploy/compose/.env
# then set PRODSIM_SECRET_KEY (>= 32 chars; e.g. `openssl rand -hex 32`) and
# POSTGRES_PASSWORD. The API refuses to start in prod with the placeholder secret.
# deploy/compose/.env is git-ignored: never commit it.
# WARNING: Postgres applies POSTGRES_PASSWORD only on first init of the db volume. Deleting
# .env but keeping the volume breaks DB login (use `make clean-data` to start over).

PRODSIM_ENVIRONMENT=prod
PRODSIM_LOG_LEVEL=INFO

# PLACEHOLDER: replace before use.
PRODSIM_SECRET_KEY=change-me

POSTGRES_USER=prodsim
POSTGRES_DB=prodsim
# PLACEHOLDER: replace before use. Use only URL-safe characters (e.g. hex).
POSTGRES_PASSWORD=change-me
